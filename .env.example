# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# ===========================================================================
# PUBLIC (exposed to the browser) — only NEXT_PUBLIC_* variables reach client code.
# Safe to expose; data is protected by Supabase Row Level Security.
# ===========================================================================

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> anon (legacy) or publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===========================================================================
# SERVER-ONLY (never prefix with NEXT_PUBLIC_, never import into client components)
# ===========================================================================

# --- Supabase --------------------------------------------------------------
# Service-role key (bypasses RLS). REQUIRED by the worker (claims jobs, writes renders)
# and by the server for encrypted API-key storage and shared caches.
# Supabase Dashboard -> Project Settings -> API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts API keys saved through Settings (AES-256-GCM). 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- AI --------------------------------------------------------------------
# Anthropic Claude — scene analysis, planning, search queries, ranking, timeline decisions.
# https://console.anthropic.com/settings/keys  (without it, a keyword-rule fallback director is used)
ANTHROPIC_API_KEY=

# Optional: OpenAI Whisper, only used to transcribe narration when no script is provided.
OPENAI_API_KEY=

# --- Media providers -------------------------------------------------------
# https://www.pexels.com/api/  (free)
PEXELS_API_KEY=
# https://pixabay.com/api/docs/  (free; key shown when logged in)
PIXABAY_API_KEY=
# https://developers.giphy.com/dashboard/  (free API key; GIFs/stickers only, not Clips)
GIPHY_API_KEY=
# Optional — Wikimedia Commons works without a key; an OAuth 2 access token raises rate limits.
WIKIMEDIA_ACCESS_TOKEN=
# Optional — Internet Archive reads are public; "access:secret" S3 keys only for authenticated calls.
INTERNET_ARCHIVE_KEYS=
# Identifying User-Agent sent to media APIs (Wikimedia policy requires contact info).
# MEDIA_USER_AGENT=DocuCutAI/0.1 (https://your-site.example; you@example.com)

# --- Worker / rendering (optional overrides) -------------------------------
# FFMPEG_PATH=            # defaults to the bundled ffmpeg-static binary
# FFPROBE_PATH=           # defaults to the bundled ffprobe-static binary
# ASSET_LIBRARY_DIR=      # defaults to ./assets/library (npm run assets:generate)
# TEMP_RETENTION_HOURS=24 # temp files / storage temp/ folders older than this are deleted
# SEARCH_CACHE_TTL_HOURS=24
# WORKER_POLL_MS=3000
